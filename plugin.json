{
	"id": "nodebb-plugin-sso-wordpress",
	"name": "NodeBB Wordpress SSO",
	"description": "Allows users to log in via a configured Wordpress account",
	"url": "https://github.com/julianlam/nodebb-plugin-sso-wordpress",
	"library": "./library.js",
	"hooks": [
		{ "hook": "static:app.preload", "method": "addMiddleware" },
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:auth.init", "method": "getStrategy" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "static:user.delete", "method": "deleteUserData" },
		{ "hook": "filter:user.whitelistFields", "method": "filterUserWhitelistFields" },
		{ "hook": "filter:user.addToApprovalQueue", "method": "addToApprovalQueue" },
		{ "hook": "filter:user.create", "method": "filterUserCreate" },
		{ "hook": "action:user.create", "method": "actionUserCreate" },
		{ "hook": "filter:user.getRegistrationQueue", "method": "filterUserGetRegistrationQueue" }
	],
	"modules": {
		"../admin/plugins/sso-wordpress.js": "./static/lib/admin.js"
	},
	"templates": "static/templates"
}
